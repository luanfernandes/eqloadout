#include <windows.h>
#include <commctrl.h>
#include "ids.h"

1 RT_MANIFEST "app.manifest"
1 ICON "eqloadout.ico"
2 ICON "paused.ico"
3 ICON "warning.ico"

IDD_SETTINGS DIALOGEX 0, 0, 400, 262
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "EQ Loadout settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Equalizer APO config folder:", -1, 7, 8, 200, 8
    EDITTEXT        IDC_DIR, 7, 18, 330, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE, 341, 18, 52, 14
    LTEXT           "Rules (checked top to bottom, first match wins):", -1, 7, 40, 250, 8
    CONTROL         "", IDC_RULES, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 50, 330, 132
    PUSHBUTTON      "Add...", IDC_ADD, 341, 50, 52, 14
    PUSHBUTTON      "Edit...", IDC_EDIT, 341, 68, 52, 14
    PUSHBUTTON      "Remove", IDC_REMOVE, 341, 86, 52, 14
    PUSHBUTTON      "Move up", IDC_UP, 341, 112, 52, 14
    PUSHBUTTON      "Move down", IDC_DOWN, 341, 130, 52, 14
    PUSHBUTTON      "Get presets...", IDC_GET_PRESETS, 341, 168, 52, 14
    LTEXT           "Default profile:", -1, 7, 191, 60, 8
    COMBOBOX        IDC_DEFAULT, 70, 189, 267, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_STATUS, 7, 208, 386, 30
    DEFPUSHBUTTON   "Save", IDOK, 287, 242, 52, 14
    PUSHBUTTON      "Close", IDCANCEL, 341, 242, 52, 14
END

IDD_RULE DIALOGEX 0, 0, 400, 282
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rule"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Exe file name:", -1, 7, 9, 90, 8
    EDITTEXT        IDC_EXE, 100, 7, 200, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Select exe...", IDC_PICKEXE, 304, 7, 89, 14
    LTEXT           "Window title contains:", -1, 7, 27, 90, 8
    EDITTEXT        IDC_TITLE, 100, 25, 293, 14, ES_AUTOHSCROLL
    LTEXT           "Profile:", -1, 7, 45, 90, 8
    COMBOBOX        IDC_PROFILE, 100, 43, 293, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Leave exe or title empty to ignore it. If both are set, both must match.", -1, 7, 62, 386, 8
    LTEXT           "Pick running app (likely games first):", -1, 7, 80, 250, 8
    CONTROL         "", IDC_APPS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 90, 386, 142
    PUSHBUTTON      "Refresh", IDC_REFRESH, 7, 237, 60, 14
    PUSHBUTTON      "Capture focused app", IDC_CAPTURE, 71, 237, 90, 14
    LTEXT           "", IDC_CAPTURE_STATUS, 167, 240, 226, 8
    DEFPUSHBUTTON   "OK", IDOK, 287, 261, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 341, 261, 52, 14
END

IDD_PRESETS DIALOGEX 0, 0, 360, 232
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Get presets"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Community presets, most voted first. Downloads go into your Equalizer APO config folder; then pick the file as a rule's profile.", -1, 7, 7, 346, 16
    CONTROL         "", IDC_PRESET_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 27, 346, 122
    LTEXT           "", IDC_PRESET_NOTES, 7, 153, 346, 24
    LTEXT           "", IDC_PRESET_STATUS, 7, 181, 346, 18
    PUSHBUTTON      "Vote on GitHub", IDC_PRESET_VOTE, 7, 211, 70, 14
    DEFPUSHBUTTON   "Download", IDC_PRESET_DOWNLOAD, 247, 211, 52, 14
    PUSHBUTTON      "Close", IDCANCEL, 301, 211, 52, 14
END
